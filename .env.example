# ── Infrastructure ────────────────────────────────────────────────────────────
# Cloud provider: "gcp" for GKE, "kind" for local KinD clusters
CLOUD_PROVIDER=gcp

# GCP project and cluster (required for GCP/GKE runs)
GCP_PROJECT_ID=your-project-id
GKE_CLUSTER_NAME=devops-bench-cluster
GCP_LOCATION=us-central1-a

# Path to GCP application-default credentials (ADC) JSON file.
# Run `gcloud auth application-default login` to generate this file.
GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json

# ── Agent configuration ───────────────────────────────────────────────────────
# Agent mode: "api" (Python SDK loop) or "cli" (external binary like gemini CLI)
BENCH_AGENT_TYPE=api

# Provider for the agent: "google" (Gemini) or "anthropic" (Claude)
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-4-8
AGENT_API_KEY=your-anthropic-api-key

# For CLI mode only — path to the agent binary
# AGENT_TARGET=gemini

# Enable/disable GKE MCP server tool integration
BENCH_USE_MCP=true
MCP_SERVER_PATH=third_party/gke-mcp/gke-mcp

# ── Judge configuration ───────────────────────────────────────────────────────
# Model used to score agent responses via LLM-as-a-Judge (DeepEval GEval)
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-opus-4-8
JUDGE_API_KEY=your-anthropic-api-key

# Alternatively, use Google Gemini as judge:
# JUDGE_PROVIDER=google
# JUDGE_MODEL=gemini-3.1-pro-preview
# JUDGE_API_KEY=your-gemini-api-key

# ── Benchmark control ─────────────────────────────────────────────────────────
# Limit the number of tasks evaluated in a single run (useful for testing)
# EVAL_LIMIT=1

# Skip cluster teardown after task (useful for debugging agent runs)
# BENCH_NO_TEARDOWN=false

# Source app location (used by deploy-hello-app task)
# APP_LOCATION=/path/to/sample-app

# Override defaults injected into task prompts
# TARGET_DEPLOYMENT_NAME=hello-app
# NAMESPACE=production
